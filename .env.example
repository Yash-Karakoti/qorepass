# QoreChain endpoints for the web app (Vite exposes only VITE_-prefixed vars).
# The public REST API sends no CORS headers, so the browser reaches it through
# the Vite dev server: requests to /lcd go to QORE_REST_PROXY_TARGET. The
# scaffolder points the targets at the network you chose.
VITE_QORE_REST_URL=/lcd
QORE_REST_PROXY_TARGET=https://api-testnet.qore.host
VITE_QORE_EVM_RPC_URL=https://evm-testnet.qore.host

# Node scripts only (scripts/hybrid-demo.ts). Never use a VITE_ prefix here.
# Testnet throwaway mnemonic only. Never use your real wallet's phrase.
DEMO_MNEMONIC=
QORE_REST_URL=https://api-testnet.qore.host
QORE_RPC_URL=https://rpc-testnet.qore.host